{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agent-native.dev/l-message.schema.json",
  "title": "L. Message",
  "description": "What the Integrity DataGuard sends an author, a hold owner, an approver or an infrastructure component, over server-sent events.",
  "type": "object",
  "properties": {
    "message": {
      "enum": [
        "CommandQueued",
        "InvariantAtRisk",
        "ValueDeclaredAhead",
        "BlockedByHold",
        "HoldExpiring",
        "ReviewRequired",
        "Parked",
        "ParkedExpiring",
        "Expired",
        "AheadResolved",
        "CommandApplied",
        "CommandRejected"
      ]
    },
    "to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "yourValue": {},
    "declaredAhead": {
      "type": "object",
      "properties": {
        "value": {},
        "by": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "by",
        "command"
      ]
    },
    "hold": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "expires": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "by",
        "expires"
      ]
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 0
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "confirm_overwrite",
          "cancel",
          "edit",
          "requeue",
          "renew",
          "approve",
          "reject"
        ]
      }
    }
  },
  "required": [
    "message",
    "to"
  ],
  "additionalProperties": true
}
